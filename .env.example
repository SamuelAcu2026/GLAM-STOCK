# ===== Plantilla de variables de entorno para PRODUCCIÓN =====
# Copiá este archivo como .env en el VPS y completá los valores reales.
# NUNCA subas el .env real al repo (está en .gitignore).

# --- Base de datos ---
POSTGRES_USER=glam
POSTGRES_PASSWORD=cambiame_por_una_clave_fuerte
POSTGRES_DB=glamstock
# El host es "db" (nombre del servicio en docker-compose), no localhost.
DATABASE_URL=postgresql://glam:cambiame_por_una_clave_fuerte@db:5432/glamstock?schema=public

# --- Autenticación (Auth.js / Google) ---
# Generá uno nuevo con: openssl rand -base64 33
AUTH_SECRET=
# URL pública de la app (tu dominio con https).
AUTH_URL=https://tudominio.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Emails permitidos, separados por coma.
ALLOWED_EMAILS=tucorreo@gmail.com

# --- Reverse proxy / HTTPS (Caddy) ---
DOMAIN=tudominio.com
TLS_EMAIL=tucorreo@gmail.com
